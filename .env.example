# LLM Provider
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
SUMMARIZATION_MODEL=deepseek-chat

# Per-operation LLM deadline in seconds. The effective deadline remains the
# smaller of this value and any RunPolicy global deadline.
LLM_OPERATION_TIMEOUT_SECONDS=180

# Searcher V2 Runtime
SEARCHER_TOTAL_TIMEOUT_SECONDS=90
SEARCHER_SEARCH_RETRY_TIMES=0
SEARCHER_EXTRACT_RETRY_TIMES=0
SEARCHER_ALLOW_PARTIAL_RESULTS=true

# P14: one bounded supplementary search after incomplete primary coverage
SEARCHER_ADAPTIVE_ENABLED=true
SEARCHER_ADAPTIVE_MAX_ROUNDS=1

# Optional P15 local lexical memory. Keep disabled for ordinary runs.
RESEARCH_MEMORY_ENABLED=false
RESEARCH_MEMORY_STORE_PATH=.cache/research_memory/memory.db
RESEARCH_MEMORY_RETRIEVAL_LIMIT=3
RESEARCH_MEMORY_SEARCH_HINT_LIMIT=2

# Optional Evidence Sidecar (disabled until explicitly enabled)
EVIDENCE_ANALYZER_ENABLED=false
EVIDENCE_MAX_DOCUMENTS=8
EVIDENCE_MAX_CHARS_PER_DOCUMENT=5000
EVIDENCE_TOTAL_TIMEOUT_SECONDS=90
EVIDENCE_RETRY_TIMES=1
EVIDENCE_ALLOW_PARTIAL_RESULTS=true

# Search Provider
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Research Limits
MAX_SEARCH_QUERIES=3
MAX_SEARCH_RESULTS_PER_QUERY=3
MIN_CREDIBILITY_SCORE=40
MAX_REPORT_SECTIONS=8
CITATION_STYLE=apa

# Optional Provider Examples
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# LLAMACPP_BASE_URL=http://localhost:8080
